@model MacroCalculator.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="dashboard-page">

    <section class="welcome-section">
        <div>
            <p class="small-heading">Security</p>
            <h1>Change Password</h1>
            <p class="muted-text">Update your account password.</p>
        </div>
    </section>

    <div class="card form-card">
        @if (ViewBag.Error != null)
        {
            <div class="error-message">@ViewBag.Error</div>
        }

        @if (ViewBag.Success != null)
        {
            <div class="success-message">@ViewBag.Success</div>
        }

        <form asp-controller="Home" asp-action="ChangePassword" method="post">

            <div class="form-group">
                <label>Current Password</label>
                <input asp-for="CurrentPassword" type="password" />
            </div>

            <div class="form-group">
                <label>New Password</label>
                <input asp-for="NewPassword" type="password" />
            </div>

            <div class="form-group">
                <label>Confirm New Password</label>
                <input asp-for="ConfirmPassword" type="password" />
            </div>

            <button type="submit" class="btn-primary">
                Change Password
            </button>

        </form>
    </div>

</div>