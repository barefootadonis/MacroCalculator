@model MacroCalculator.Models.User

@{
    ViewData["Title"] = "Profile";
}

<div class="dashboard-page">

    <section class="welcome-section">
        <div>
            <p class="small-heading">Account</p>
            <h1>Profile</h1>
            <p class="muted-text">Update your personal information and body stats.</p>
        </div>
    </section>

    <div class="profile-layout">

        <div class="card profile-summary-card">
            <div class="profile-avatar">
                @Model.Username.Substring(0, 1).ToUpper()
            </div>

            <h2>@Model.Username</h2>
            <p>@Model.Email</p>

            <div class="profile-stat">
                <span>Current Weight</span>
                <strong>@Model.CurrentWeight.ToString("0.00") kg</strong>
            </div>

            <div class="profile-stat">
                <span>Goal Weight</span>
                <strong>@Model.GoalWeight.ToString("0.00") kg</strong>
            </div>

            <div class="profile-stat">
                <span>Activity Level</span>
                <strong>@Model.ActivityLevel</strong>
            </div>
        </div>

        <div class="card form-card">
            <form asp-action="Profile" asp-controller="Home" method="post">

                <input type="hidden" asp-for="UserId" />

                <div class="form-grid">
                    <div class="form-group">
                        <label>First Name</label>
                        <input asp-for="FirstName" />
                    </div>

                    <div class="form-group">
                        <label>Last Name</label>
                        <input asp-for="LastName" />
                    </div>

                    <div class="form-group">
                        <label>Username</label>
                        <input asp-for="Username" />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input asp-for="Email" />
                    </div>

                    <div class="form-group">
                        <label>Phone Number</label>
                        <input asp-for="PhoneNumber" />
                    </div>

                    <div class="form-group">
                        <label>Date of Birth</label>
                        <input asp-for="DateOfBirth" type="date" />
                    </div>

                    <div class="form-group">
                        <label>Gender</label>
                        <select asp-for="Gender">
                            <option value="">Select gender</option>
                            <option>Female</option>
                            <option>Male</option>
                            <option>Other</option>
                            <option>Prefer not to say</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Height (cm)</label>
                        <input asp-for="Height" type="number" step="0.01" />
                    </div>

                    <div class="form-group">
                        <label>Current Weight (kg)</label>
                        <input asp-for="CurrentWeight" type="number" step="0.01" />
                    </div>

                    <div class="form-group">
                        <label>Goal Weight (kg)</label>
                        <input asp-for="GoalWeight" type="number" step="0.01" />
                    </div>

                    <div class="form-group">
                        <label>Activity Level</label>
                        <select asp-for="ActivityLevel">
                            <option>Low</option>
                            <option>Moderate</option>
                            <option>High</option>
                        </select>
                    </div>
                </div>

                <a asp-controller="Home" asp-action="ChangePassword" class="btn-secondary profile-password-btn">
                    Change Password
                </a>

                <button type="submit" class="btn-primary">
                    Save Profile
                </button>

            </form>
        </div>

    </div>
</div>