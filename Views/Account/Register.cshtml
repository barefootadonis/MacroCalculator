@model MacroCalculator.ViewModels.RegisterViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign Up";
}

<div class="login-card register-card">
    <h1>Create Account</h1>
    <p>Set up your profile, calorie target and macro goals.</p>

    @if (ViewBag.Error != null)
    {
        <div class="error-message">@ViewBag.Error</div>
    }

    <form asp-controller="Account" asp-action="Register" method="post">

        <h3 class="form-section-title">Account Details</h3>

        <div class="form-grid">
            <div class="form-group">
                <label>Username</label>
                <input asp-for="Username" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" type="email" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input asp-for="Password" type="password" />
            </div>

            <div class="form-group">
                <label>Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" />
            </div>
        </div>

        <h3 class="form-section-title">Personal Information</h3>

        <div class="form-grid">
            <div class="form-group">
                <label>First Name</label>
                <input asp-for="FirstName" />
            </div>

            <div class="form-group">
                <label>Last Name</label>
                <input asp-for="LastName" />
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                <input asp-for="PhoneNumber" />
            </div>

            <div class="form-group">
                <label>Date of Birth</label>
                <input asp-for="DateOfBirth" type="date" />
            </div>

            <div class="form-group">
                <label>Gender</label>
                <select asp-for="Gender">
                    <option value="">Select gender</option>
                    <option>Female</option>
                    <option>Male</option>
                    <option>Other</option>
                    <option>Prefer not to say</option>
                </select>
            </div>

            <div class="form-group">
                <label>Activity Level</label>
                <select asp-for="ActivityLevel">
                    <option value="">Select activity level</option>
                    <option>Low</option>
                    <option>Moderate</option>
                    <option>High</option>
                </select>
            </div>
        </div>

        <h3 class="form-section-title">Body Stats</h3>

        <div class="form-grid">
            <div class="form-group">
                <label>Height (cm)</label>
                <input asp-for="Height" type="number" step="0.01" />
            </div>

            <div class="form-group">
                <label>Current Weight (kg)</label>
                <input asp-for="CurrentWeight" type="number" step="0.01" />
            </div>

            <div class="form-group">
                <label>Goal Weight (kg)</label>
                <input asp-for="GoalWeight" type="number" step="0.01" />
            </div>
        </div>

        <h3 class="form-section-title">Daily Targets</h3>

        <div class="form-grid">
            <div class="form-group">
                <label>Daily Calorie Goal</label>
                <input asp-for="DailyCalorieGoal" type="number" />
            </div>

            <div class="form-group">
                <label>Target Protein (g)</label>
                <input asp-for="TargetProtein" type="number" step="0.01" />
            </div>

            <div class="form-group">
                <label>Target Carbs (g)</label>
                <input asp-for="TargetCarbs" type="number" step="0.01" />
            </div>

            <div class="form-group">
                <label>Target Fat (g)</label>
                <input asp-for="TargetFat" type="number" step="0.01" />
            </div>

            <div class="form-group">
                <label>Target Fiber (g)</label>
                <input asp-for="TargetFiber" type="number" step="0.01" />
            </div>
        </div>

        <button type="submit" class="btn-primary login-btn">
            Create Account
        </button>

        <div class="auth-switch-link">
            <span>Already have an account?</span>
            <a asp-controller="Account" asp-action="Login">Log in</a>
        </div>

    </form>
</div>