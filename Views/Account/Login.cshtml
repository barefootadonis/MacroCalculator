@model MacroCalculator.ViewModels.LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<div class="login-page">
    <div class="login-card">
        <h1>Welcome Back</h1>
        <p>Log in to track your meals and macros.</p>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">@ViewBag.Error</div>
        }

        <form asp-action="Login" method="post">
            <div class="form-group">
                <label>Username or Email</label>
                <input asp-for="UsernameOrEmail" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input asp-for="Password" type="password" />
            </div>

            <div class="forgot-password-link">
                <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
            </div>

            <button type="submit" class="btn-primary login-btn">Login</button>

            <div class="auth-switch-link">
                <span>Don’t have an account?</span>
                <a asp-controller="Account" asp-action="Register">Sign up</a>
            </div>
        </form>
    </div>
</div>