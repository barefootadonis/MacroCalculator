@model MacroCalculator.ViewModels.ForgotPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="login-card">
    <h1>Reset Password</h1>
    <p>Confirm your account details first.</p>

    @if (ViewBag.Error != null)
    {
        <div class="error-message">@ViewBag.Error</div>
    }

    @if (ViewBag.Success != null)
    {
        <div class="success-message">@ViewBag.Success</div>
    }

    <form asp-controller="Account" asp-action="ForgotPassword" method="post">

        <div class="form-group">
            <label>Username</label>
            <input asp-for="Username" readonly="@Model.Verified" />
        </div>

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" type="email" readonly="@Model.Verified" />
        </div>

        <div class="form-group">
            <label>Date of Birth</label>
            <input asp-for="DateOfBirth" type="date" readonly="@Model.Verified" />
        </div>

        <input type="hidden" asp-for="Verified" />

        @if (Model.Verified)
        {
            <div class="success-message">
                Account verified. Enter your new password below.
            </div>

            <div class="form-group">
                <label>New Password</label>
                <input asp-for="NewPassword" type="password" />
            </div>

            <div class="form-group">
                <label>Confirm New Password</label>
                <input asp-for="ConfirmPassword" type="password" />
            </div>

            <button type="submit" name="actionType" value="Reset" class="btn-primary login-btn">
                Reset Password
            </button>
        }
        else
        {
            <button type="submit" name="actionType" value="Verify" class="btn-primary login-btn">
                Verify Account
            </button>
        }

        <div class="auth-switch-link">
            <span>Remembered it?</span>
            <a asp-controller="Account" asp-action="Login">Log in</a>
        </div>

    </form>
</div>